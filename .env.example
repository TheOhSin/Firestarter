# Firestarter container configuration
#
# Copy this file to .env before starting:
#   cp .env.example .env
#
# Discord and Fireshare credentials are configured through
# the Firestarter WebUI and are not stored in this file.

APP_VERSION=1.0.0-rc1

# Address Firestarter listens on from the Docker host.
#
# 127.0.0.1 = local host / reverse proxy only
# 0.0.0.0   = all host interfaces
# Or use the server's LAN IP.
FIRESTARTER_BIND_IP=127.0.0.1

# WebUI port
WEB_PORT=8090

# Persistent application database
DATABASE_PATH=/data/bot.db
FIRESTARTER_DATA_DIR=./data

# false for normal LAN HTTP access.
# Set true when the WebUI itself is served through HTTPS.
WEB_SECURE_COOKIES=false

# Linux Docker host alias.
#
# Normally leave this as-is. If Fireshare uses a hostname that
# must resolve back to the Docker host, this can be changed to
# that hostname.
FIRESHARE_HOST_ALIAS=host.docker.internal

# Optional overrides
# FIRESTARTER_IMAGE=firestarter
# FIRESTARTER_CONTAINER_NAME=firestarter
